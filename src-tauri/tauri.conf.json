{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "storyagent",
  "version": "0.1.30",
  "identifier": "com.od23.storyagent",
  "build": {
    "beforeDevCommand": "npm run ui:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run ui:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "StoryAgent",
        "label": "main",
        "visible": false,
        "resizable": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI1MTVCMEM0NEJDOTA0QjIKUldTeUJNbEx4TEFWdGVvQkt2dnNNbXJQbGRKa0dpUjJ5ZHNKWUx6Z05POGFpV2h2SU5XZmNQNGUK",
      "endpoints": ["https://github.com/listensay/StoryAgent/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
